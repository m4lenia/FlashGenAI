rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Test connection probe
    match /test/{docId} {
      allow read: if true;
    }

    // Global Safety Net: Default-deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // The manager role is strictly locked to this exact verified email
    function isManager() {
      return isSignedIn() &&
             request.auth.token.email == 'm4len1as@gmail.com' &&
             request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isManager();
      allow list: if isManager();
      allow create: if isOwner(userId) && (isManager() || request.resource.data.role == 'user');
      allow update: if isOwner(userId) && (isManager() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isManager();
    }

    // Decks Collection
    match /decks/{deckId} {
      allow get: if (isSignedIn() && resource.data.userId == request.auth.uid) || isManager();
      allow list: if isManager() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isManager();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isManager();
    }

    // Test Results Collection
    match /testResults/{resultId} {
      allow get: if (isSignedIn() && resource.data.userId == request.auth.uid) || isManager();
      allow list: if isManager() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isManager();
    }

    // Study Pages Collection (Turbo AI style study notebooks)
    match /studyPages/{pageId} {
      allow get: if (isSignedIn() && resource.data.userId == request.auth.uid) || isManager();
      allow list: if isManager() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isManager();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isManager();
    }
  }
}
